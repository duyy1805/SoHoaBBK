# Thêm các biến này vào file .env hiện tại của backend Z76.
# DB2_SERVER/USER/PASSWORD có thể bỏ trống nếu giống kết nối DB cổng 3400.
DB2_SERVER=
DB2_PORT=3402
DB2_DATABASE=TAG_Duy
DB2_USER=
DB2_PASSWORD=

PLP_UNIT_CODE=PHAT_LONG_PHUOC
PLP_UNIT_ID=1
PLP_UNIT_NAME=Xí nghiệp 76.1

# Tùy chọn. Để trống để xác thực MD5 trực tiếp từ 3402.TAG_System.
PLP_AUTH_PROCEDURE=
